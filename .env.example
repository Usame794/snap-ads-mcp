# Snapchat Marketing API OAuth app (create it in Snap Business Manager > Business Details > OAuth Apps)
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
# Refresh token from the one-time authorization (see README)
SNAP_REFRESH_TOKEN=
# Default ad account id (find it in Ads Manager or via the snap_ping tool)
SNAP_AD_ACCOUNT_ID=
# Safety limits (optional; plain numbers in account currency; an invalid value stops the server; restart to apply)
SNAP_MAX_DAILY_BUDGET=1000
SNAP_MIN_DAILY_BUDGET=5
SNAP_MAX_BID=50
SNAP_MAX_BUDGET_INCREASE_PCT=100
SNAP_MAX_BID_INCREASE_PCT=50
# Optional: SNAP_MAX_LIFETIME_BUDGET, SNAP_MAX_ACTIVATION_DAILY_BUDGET, SNAP_MAX_ADDED_DAILY_BUDGET_24H, SNAP_ACCOUNT_CURRENCY=USD,
# SNAP_READ_ONLY=1, SNAP_HUMAN_APPROVAL=elicit (see README "Safety settings")
# Only needed once, by scripts/get-refresh-token.js (must match the redirect URL on your OAuth app)
SNAP_REDIRECT_URI=https://127.0.0.1/callback
# Brand profile id (only needed to claim creator ad codes)
SNAP_BRAND_PROFILE_ID=
# Default pixel id for new ad squads
SNAP_PIXEL_ID=
